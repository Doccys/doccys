# npm 11's allow-scripts-port: postinstall-scripts for disse pakker er
# godkendte (ffmpeg-static downloader sin platform-binary ved install —
# påkrævet for trailer-klippet + undertekst-pipelinen på Vercel, der
# har ingen system-ffmpeg; esbuild's install-script til Next-build).
allow-scripts=ffmpeg-static,esbuild
