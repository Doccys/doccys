# Skabelon til miljøvariabler — kopier til .env.local og udfyld værdierne.
# (.env.local er git-ignoreret; denne skabelon er det ikke.)

# Supabase → dit projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role-nøgle (fuld databaseadgang — må ALDRIG være NEXT_PUBLIC_!)
# Supabase → Settings → API → service_role. Bruges kun af Stripe-webhook-ruten.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe-dashboardet → Developers → API keys (test-tilstand til at starte med)
STRIPE_SECRET_KEY=

# Stripe-dashboardet → Developers → Webhooks → endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# OpenAI → platform.openai.com → API keys. Server-side kun (ALDRIG
# NEXT_PUBLIC_) — bruges af undertekst-pipelinen (whisper-1 + gpt-4o-mini).
# NB: Pipelinen kræver også ffmpeg på serveren: winget install ffmpeg
OPENAI_API_KEY=